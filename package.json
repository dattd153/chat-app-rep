{
  "name": "chat-app-repo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Microservice Chat Application",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start": "docker-compose up -d",
    "stop": "docker-compose down",
    "test": "jest",
    "build:packages": "npm run build --workspaces --if-present"
  },
  "keywords": [
    "chat",
    "microservices",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^6.0.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12",
    "axios": "^1.6.2",
    "socket.io-client": "^4.7.2"
  }
}
